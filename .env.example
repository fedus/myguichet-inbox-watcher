# Copy this file to .env and fill in the values. .env contains credentials and
# is deliberately ignored by Git.

# Single-account / backward-compatible setup.
LUXTRUST_USERNAME=
LUXTRUST_PASSWORD=
MYGUICHET_SPACE_ID=
MYGUICHET_DOWNLOAD_DIR=downloads
# Defaults are private. For a Paperless consume folder mounted for another
# container/user, 0644 is often easier than the default 0600.
# MYGUICHET_DOWNLOAD_FILE_MODE=0600
# MYGUICHET_DOWNLOAD_DIR_MODE=0700

# Multi-account setup. Account names may contain letters, numbers, and
# underscores. If this is set, use per-account variables instead of the legacy
# LUXTRUST_USERNAME/LUXTRUST_PASSWORD/MYGUICHET_SPACE_ID values above.
# MYGUICHET_ACCOUNTS=alice,bob
# MYGUICHET_ALICE_LUXTRUST_USERNAME=
# MYGUICHET_ALICE_LUXTRUST_PASSWORD=
# MYGUICHET_ALICE_SPACE_ID=
# MYGUICHET_ALICE_DOWNLOAD_DIR=/private/documents/alice
# MYGUICHET_ALICE_DOWNLOAD_FILE_MODE=0644
# MYGUICHET_ALICE_DOWNLOAD_DIR_MODE=0775
# MYGUICHET_BOB_LUXTRUST_USERNAME=
# MYGUICHET_BOB_LUXTRUST_PASSWORD=
# MYGUICHET_BOB_SPACE_ID=
# MYGUICHET_BOB_DOWNLOAD_DIR=/private/documents/bob

# Use true on a shell-only host. LuxTrust device approval remains external.
MYGUICHET_HEADLESS=true

# The language is used by both the browser and API requests.
MYGUICHET_LANGUAGE=fr

# Optional limits. Values are positive integers.
# MYGUICHET_LOGIN_TIMEOUT_SECONDS=300
# MYGUICHET_MAX_ATTACHMENT_MB=100

# MQTT trigger. Publish an empty payload, "all", or an account name to trigger
# polling. JSON payloads like {"account":"alice"} are also accepted.
# MYGUICHET_MQTT_HOST=localhost
# MYGUICHET_MQTT_PORT=1883
# MYGUICHET_MQTT_TOPIC=myguichet/poll
# MYGUICHET_MQTT_STATUS_TOPIC=myguichet/poll/status
# MYGUICHET_MQTT_USERNAME=
# MYGUICHET_MQTT_PASSWORD=
