# Copy this file to .env and fill in the values. .env contains credentials and
# is deliberately ignored by Git.
LUXTRUST_USERNAME=
LUXTRUST_PASSWORD=

# Use true on a shell-only host. LuxTrust device approval remains external.
MYGUICHET_HEADLESS=true

# The language is used by both the browser and API requests.
MYGUICHET_LANGUAGE=fr

# Required. Every MyGuichet account has a different space ID -- see README
# for how to find yours.
MYGUICHET_SPACE_ID=

# Optional limits. Values are positive integers.
# MYGUICHET_LOGIN_TIMEOUT_SECONDS=300
# MYGUICHET_MAX_ATTACHMENT_MB=100
