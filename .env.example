# Copy this file to .env and fill in the values. .env contains credentials and
# is deliberately ignored by Git.

# One user can have one or more source services.
DOCUMENT_USERS=alice
DOCUMENT_ALICE_SOURCES=myguichet

# Alice: MyGuichet source.
DOCUMENT_ALICE_MYGUICHET_LUXTRUST_USERNAME=
DOCUMENT_ALICE_MYGUICHET_LUXTRUST_PASSWORD=
DOCUMENT_ALICE_MYGUICHET_SPACE_ID=
DOCUMENT_ALICE_MYGUICHET_LANGUAGE=fr
DOCUMENT_ALICE_MYGUICHET_HEADLESS=true
# DOCUMENT_ALICE_MYGUICHET_LOGIN_TIMEOUT_SECONDS=300

# Alice: save documents to a folder.
DOCUMENT_ALICE_MYGUICHET_OUTPUTS=local:folder
DOCUMENT_ALICE_MYGUICHET_OUTPUT_LOCAL_DIRECTORY=downloads/alice_myguichet
# Defaults are private. For a Paperless consume folder mounted for another
# container/user, 0644 is often easier than the default 0600.
# DOCUMENT_ALICE_MYGUICHET_OUTPUT_LOCAL_FILE_MODE=0600
# DOCUMENT_ALICE_MYGUICHET_OUTPUT_LOCAL_DIR_MODE=0700

# Account-level runtime and safety limits.
# DOCUMENT_ALICE_MYGUICHET_RUNTIME_DIR=accounts/alice_myguichet
# DOCUMENT_ALICE_MYGUICHET_MAX_DOCUMENT_MB=100

# Optional second source example: DKV/Lalux EasyApp treated reimbursements.
# Add "dkv" to DOCUMENT_ALICE_SOURCES to enable it.
# DOCUMENT_ALICE_DKV_USERNAME=
# DOCUMENT_ALICE_DKV_PASSWORD=
# DOCUMENT_ALICE_DKV_OTP_TYPE=SMS
# DOCUMENT_ALICE_DKV_OTP_TIMEOUT_SECONDS=300
# DOCUMENT_ALICE_DKV_PAGE_LIMIT=20
# DOCUMENT_ALICE_DKV_OUTPUTS=local:folder
# DOCUMENT_ALICE_DKV_OUTPUT_LOCAL_DIRECTORY=downloads/alice_dkv

# MQTT trigger. Publish an empty payload, "all", or an account name to trigger
# polling. JSON payloads like {"account":"alice_myguichet"} are also accepted.
# DOCUMENT_RUN_MODE=mqtt
# DOCUMENT_MQTT_HOST=localhost
# DOCUMENT_MQTT_PORT=1883
# DOCUMENT_MQTT_TOPIC=documents/poll
# DOCUMENT_MQTT_STATUS_TOPIC=documents/poll/status
# DOCUMENT_MQTT_USERNAME=
# DOCUMENT_MQTT_PASSWORD=
